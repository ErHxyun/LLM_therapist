[Unit]
Description=CaiTI emotion side-channel service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xiyun
Group=xiyun
WorkingDirectory=/home/xiyun/Desktop/Projects/emo_module
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env bash -lc 'cd /home/xiyun/Desktop/Projects/emo_module && exec python -m uvicorn app.main:app --host 127.0.0.1 --port 8000'
Restart=always
RestartSec=2
TimeoutStopSec=10
StandardOutput=append:/home/xiyun/Desktop/Projects/LLM_therapist/data/logs/systemd-caiti-emotion.log
StandardError=append:/home/xiyun/Desktop/Projects/LLM_therapist/data/logs/systemd-caiti-emotion.log

[Install]
WantedBy=multi-user.target
